{
  "manifest_version": 3,
  "name": "CodeSpace Bridge",
  "version": "1.2.0",
  "description": "Lets your CodeSpace AI agent read, click and type in tabs it opens or you share, using your own Chrome.",
  "minimum_chrome_version": "110",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "CodeSpace Bridge", "default_popup": "popup.html" }
}
